PKOS_BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://pkos:pkos@localhost:5432/pkos
POSTGRES_PASSWORD=replace-with-a-long-random-secret
PKOS_OWNER_ID=00000000-0000-0000-0000-000000000001
PKOS_API_KEY=replace-with-a-long-random-secret
PKOS_DATABASE_MAX_CONNECTIONS=20
PKOS_LEXICAL_BACKEND=pgroonga
PKOS_SEARCH_CANDIDATE_LIMIT=40
PKOS_SEARCH_RESULT_LIMIT=12
PKOS_WORKER_POLL_MS=1000
PKOS_WORKER_BATCH_SIZE=8
PKOS_WORKER_ENABLED=true

# OpenAI-compatible embedding provider. Lexical search still works when unset.
PKOS_OPENAI_BASE_URL=https://api.openai.com/v1
PKOS_OPENAI_API_KEY=
PKOS_EMBEDDING_MODEL=text-embedding-3-small
PKOS_EMBEDDING_DIMENSIONS=1536

# Automatic memory extraction. Memory provider falls back to PKOS_OPENAI_* when blank.
PKOS_MEMORY_BASE_URL=
PKOS_MEMORY_API_KEY=
PKOS_MEMORY_MODEL=gpt-5-mini
PKOS_MEMORY_EXTRACTION_ENABLED=false
PKOS_MEMORY_AUTO_PROMOTE_ENABLED=true
PKOS_MEMORY_AUTO_PROMOTE_MIN_CONFIDENCE=0.92
PKOS_MEMORY_AUTO_PROMOTE_MIN_IMPORTANCE=0.65
PKOS_MEMORY_KEEP_UNPROMOTED_CANDIDATES=false
PKOS_MEMORY_MAX_CANDIDATES_PER_SOURCE=8
PKOS_MEMORY_CONTEXT_LIMIT=50

# MCP gateway. Keep this local secret separate from PKOS_API_KEY.
# When using ChatGPT Secure MCP Tunnel, ChatGPT authentication is "none" and tunnel-client
# injects this value as the local Authorization header. The credential never needs to be
# configured in ChatGPT itself.
PKOS_MCP_BEARER_TOKEN=replace-with-a-different-long-random-secret
PKOS_MCP_PUBLIC_HOSTNAME=
PKOS_MCP_ALLOWED_HOSTS=
PKOS_MCP_ALLOWED_ORIGINS=

RUST_LOG=personal_knowledge_os=info,tower_http=info
