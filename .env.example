PKOS_BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://pkos:pkos@localhost:5432/pkos
PKOS_OWNER_ID=00000000-0000-0000-0000-000000000001
PKOS_API_KEY=replace-with-a-long-random-secret
PKOS_DATABASE_MAX_CONNECTIONS=20
PKOS_LEXICAL_BACKEND=pgroonga
PKOS_SEARCH_CANDIDATE_LIMIT=40
PKOS_SEARCH_RESULT_LIMIT=12
PKOS_WORKER_POLL_MS=1000
PKOS_WORKER_BATCH_SIZE=8
PKOS_WORKER_ENABLED=true

# OpenAI-compatible provider. If unset, ingestion/search still works in lexical-only mode.
PKOS_OPENAI_BASE_URL=https://api.openai.com/v1
PKOS_OPENAI_API_KEY=
PKOS_EMBEDDING_MODEL=text-embedding-3-small
PKOS_EMBEDDING_DIMENSIONS=1536
PKOS_MEMORY_MODEL=gpt-5-mini
PKOS_MEMORY_EXTRACTION_ENABLED=false

RUST_LOG=personal_knowledge_os=info,tower_http=info
